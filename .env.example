# AI Bridge — example environment file
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Application environment: development | production
APP_ENV=development

# Ollama base URL (default assumes Ollama is running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Default model name to use with Ollama
DEFAULT_MODEL=llama3.2

# Default routing; omitted/null request provider uses this value.
DEFAULT_PROVIDER=ollama

# OpenAI-compatible backend (required only when selected).
# Accepts either a root URL or a URL ending in /v1.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
# Set to a chat-capable model available on your configured backend.
OPENAI_MODEL=
